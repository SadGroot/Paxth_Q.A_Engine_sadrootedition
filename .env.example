# Database Connection String for PostgreSQL (e.g. Supabase, Neon)
# For Supabase, paste the exact Dashboard → Connect → Session pooler URI. Do not
# alter its region, port, or username; it should include ?sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paxth_qa_engine

# Development detects Codespaces or uses the local origin when empty.
# A future production installation requires an HTTPS origin and protected backend binding.
APP_ORIGIN=
# For a native systemd deployment; Docker keeps its default 0.0.0.0 binding.
# HOST=127.0.0.1
# Distinct server-only AI Credits keys, permanently assigned to user IDs at creation.
# Configure one per account (including admins); unused slots can remain empty.
AICREDITS_API_KEY_1=
AICREDITS_API_KEY_2=
AICREDITS_API_KEY_3=
AICREDITS_API_KEY_4=
AICREDITS_API_KEY_5=
# Server-only Crawl4AI cloud key; URL scraping also requires model credentials above.
CRAWL4AI_API_KEY=
# Server-only TinyFish key for IDQ identification and web research.
TINYFISH_API_KEY=
# One-time bootstrap command only; remove these from the environment after use.
# BOOTSTRAP_ADMIN_USERNAME=your-admin-name
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-password-of-at-least-12-characters

# Q&A and Scraping / Markdown models are editable independently in LLM Settings.
# Admins set global defaults and workspace overrides. Users can view their effective settings.
